# Copy values to your process environment, or use Docker Compose --env-file.
# This application does not read .env files automatically.
TELEGRAM_BOT_TOKEN=replace_with_test_bot_token
MANAGER_TELEGRAM_ID=123456789
DATABASE_PATH=data/catalog.sqlite3
# Only an explicitly provided catalog is imported, and only into an empty DB.
DEMO_CATALOG_PATH=examples/store_catalog.csv
STORE_DATA_PATH=examples/store.json
MAX_MESSAGE_LENGTH=2000
CLIENT_REQUESTS_PER_WINDOW=20
CLIENT_RATE_WINDOW_SECONDS=60
MANAGER_CONTEXT_LIMIT=3000
# Remind the manager about an unanswered ticket after N minutes (working hours only). 0 disables.
SUPPORT_REMINDER_MINUTES=15

# Paid calls are disabled by default. Enable only after approving API spending.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Supply the chosen model's actual current USD tariffs. No guessed defaults.
LLM_DAILY_BUDGET_USD=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHE_WRITE_USD_PER_MILLION=
LLM_CACHE_READ_USD_PER_MILLION=
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=400
LLM_MAX_CALLS_PER_MESSAGE=2
LLM_TIMEOUT_SECONDS=15
